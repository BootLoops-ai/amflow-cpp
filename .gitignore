# Build directories
build/
build_*/
cmake-build-*/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Local agent metadata
.claude/

# Local logs / scratch
*.log
id

# Temporary outputs
/tmp_output/
*_out.json

# Heavy Mathematica caches (regenerable; see tools/bench/README.md and
# tools/math_ref/run_amflow_kira.wl for instructions). Only the
# scripts (*_black_box_amflow_{cpp.json,mma.wl}) and the final
# *_mma_reference.json summary should be committed; never the
# Kira/Fermat/Mathematica intermediate cache trees.
tools/bench/mma_refs/
tools/bench/*/mma_refs/
tools/math_ref/cache/

# Upstream Mathematica AMFlow — populate via clone or symlink locally;
# never tracked here.  See reference/README.md.
reference/amflow-master/

# Locally-pasted error logs (e.g. CI failure paste-ins) — never commit.
errors

# BootLoops validation-harness outputs (bootloops-wrappers/run_tier*.sh default OUT)
bootloops-wrappers/results/
