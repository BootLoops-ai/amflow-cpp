{
  "mode": "black_box_amflow",
  "options": {
    "working_pre": 120, "chop_pre": 20, "rationalize_pre": 100, "silent_mode": true,
    "x_order": 200, "extra_x_order": 240, "learn_x_order": -1, "test_x_order": 5
  },
  "family": {
    "name": "box4m",
    "loops": ["l"],
    "legs": ["p1", "p2", "p3", "p4"],
    "conservation": {"p4": "-p1 - p2 - p3"},
    "replacement": {
      "p1^2": "0", "p2^2": "0", "p3^2": "0", "p4^2": "0",
      "(p1 + p2)^2": "s", "(p1 + p3)^2": "t"
    },
    "propagators": [
      "l^2 - mAsq",
      "(l + p1)^2 - mBsq",
      "(l + p1 + p2)^2 - mCsq",
      "(l + p1 + p2 + p4)^2 - mDsq"
    ]
  },
  "integrals": [
    { "indices": [1, 1, 1, 1] }
  ],
  "eps_samples": ["1/1000"],
  "work_dir": "/tmp/amflow_bench_box_1L_4mass_eps001_cpp",
  "amf_options": {
    "ending_schemes": ["Tradition", "SingleMass"],
    "max_recursion_depth": 16,
    "blackbox": {
      "ibp_rank": 0, "ibp_dot": 3, "integral_order": 5, "n_thread": 4,
      "numeric_values": {
        "s": "-3", "t": "-1", "mAsq": "1", "mBsq": "4", "mCsq": "9", "mDsq": "16"
      }
    }
  }
}
