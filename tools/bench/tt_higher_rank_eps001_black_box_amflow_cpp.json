    { "indices": [1, 1, 1, 1, 1, 1, 1, -3, -3] }
  ],
  "eps_samples": ["1/1000"],
  "work_dir": "/tmp/desolver_bench_tt_higher_rank_eps001_cpp",
  "amf_options": {
    "ending_schemes": ["Tradition", "SingleMass"],
    "max_recursion_depth": 16,
    "blackbox": {
      "ibp_rank": 6,
