    "blackbox": {
      "ibp_rank": 0,
      "ibp_dot": 1,
      "integral_order": 5,
      "n_thread": 4,
      "numeric_values": {
        "s": "-3",
        "t": "-1",
        "msq": "1"
      }
    }
  }
